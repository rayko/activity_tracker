<% tally ||= 0 %>
<% if tally > 0 %>
  <div class="flex flex-row">
    <% rest = tally % 5 %>
    <% sets = tally / 5 %>
    <% sets.times do %>
      <%= vite_image_tag "images/boxTally5.svg", class: "p-1 block-6 md:block-10" %>
    <% end %>
    <% if rest > 0 %>
      <%= vite_image_tag "images/boxTally#{rest}.svg", class: "p-1 block-6 md:block-10"  %>
    <% end %>
  </div>
<% end %>
