<div class="p-2 text-left">

  <%= form_with(model: activity, builder: FormBuilders::Common) do |form| %>

    <%= form.text_field :name, autofocus: true %>
    <%= form.text_area :description %>
    <%= form.divider %>
    <%= form.buttons do %>
      <%= form.submit "Save" %>
      <%= link_to_back %>
    <% end %>

  <% end %>

</div>
