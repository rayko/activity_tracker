<div class="activity-list mb-5">
  <table class="table-auto w-full text-sm sm:text-lg border-separate border-spacing-y-4 ">
    <tbody>
      <% current_user.activities.each do |activity| %>
      <tr class="shadow-md shadow-gray-500 bg-slate-200">
        <td class="activity-name p-2 bg-slate-300 text-nowrap border-r-3 border-r-gray-300">
          <span title="<%= activity.description %>" >
            <%= link_to activity.name, activity_path(activity), class: "text-sky-700" %>
          </span>
        </td>

        <td class="activity-hits p-2 w-full ">
          <%= activity_hits_display(activity) %>
        </td>

        <td class="activity-actions p-2">
          <div class="flex flex-row">
            <%= button_to "+", register_hit_activity_path(activity), method: :post, class: regular_btn_class %>
            <%= button_to "-", unregister_hit_activity_path(activity), method: :post, class: regular_red_btn_class %>
          </div>
        </td>
      </tr>
      <% end %>

    </tbody>
  </table>
</div>

<div class="w-50">
  <%= link_to "New activity", new_activity_path, class: regular_btn_class %>
</div>
