<div class="bg-gray-100 max-w-2xs my-10 items-center outline-1 outline-gray-300 rounded-xl p-6 shadow-lg">
  <div class="login-form w-full">
    <h3>Recover Password</h3>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }, builder: FormBuilders::Devise) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.email_field :email %>

      <div class="actions">
        <%= f.submit "Send Instructions", class: blue_btn_class %>
      </div>
    <% end %>

    <hr class="my-4">
    <%= render "devise/shared/links" %>
  </div>
</div>
