<div class="bg-gray-100 max-w-2xs my-10 items-center outline-1 outline-gray-300 rounded-xl p-6 shadow-lg">
  <div class="login-form w-full">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), builder: FormBuilders::Devise) do |f| %>
      <%= f.email_field :email %>
      <%= f.password_field :password %>

      <% if devise_mapping.rememberable? %>
        <%= f.remember_me_field :remember_me %>
      <% end %>

      <div class="actions">
        <%= f.submit "Log in", class: blue_btn_class %>
      </div>
      <% end %>

      <hr class="my-4">

      <%= render "devise/shared/links" %>

  </div>
</div>
