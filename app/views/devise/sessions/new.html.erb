<div class="bg-gray-100 mx-auto flex max-w-2xs my-10 items-center outline-1 outline-gray-300 rounded-xl p-6 shadow-lg">

  <div class="login-form w-full">
    <h2 class="text-xl text-black">Log in</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), builder: FormBuilders::Devise) do |f| %>
      <%= f.email_field :email %>
      <%= f.password_field :password %>

      <% if devise_mapping.rememberable? %>
        <%= f.remember_me_field :remember_me %>
      <% end %>

    <div class="actions">
      <%= f.submit "Log in" %>
    </div>
    <% end %>

    <%= render "devise/shared/links" %>

  </div>
</div>
