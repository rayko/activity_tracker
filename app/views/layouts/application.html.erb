<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Activity Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Activity Tracker">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application' %>
  </head>

  <body>
    <% if user_signed_in?  %>
      <nav class="flex flex-row p-1 items-center bg-linear-to-t from-gray-400 to-gray-50 border-b-1 border-b-gray-400">
        <div class="flex flex-row items-center">
          <span>Logo</span>
          <div class="title mx-2 text-slate-500 text-shadow-md/15 italic">
            <%= link_to "Activity Tracker", root_path %>
          </div>
        </div>
        <div class="flex-grow"></div>
        <div class="flex flex-row items-center">
          <div class="dropdown-trigger" data-target-id="user-options-dropdown">
            <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
          </div>
          <div id="user-options-dropdown" class="hidden block text-center z-100 absolute top-12 right-2 w-1/8 border-1 border-gray-300 bg-gray-100">
            <%= link_to "Account", user_path, class: "block text-sky-700 p-2 border-b border-gray-400 hover:text-white hover:bg-sky-600" %>
            <%= link_to "Manage Activities", '#', class: "block text-sky-700 p-2 border-b border-gray-400 hover:text-white hover:bg-sky-600" %>            
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "cursor-pointer text-sky-700 block p-2 hover:text-white hover:bg-sky-600 w-full" %>
            
          </div>
        </div>
      </nav>

      <div class="info">
        <%- if notice %>
        <div class="notice bg-green-300 w-full p-1 text-center text-[1.2em] shadow-md shadow-green-400/50 text-green-700 text-shadow-xs">
          <%= notice %>
        </div>
        <% end %>

        <%- if alert %>
        <div class="alert notice bg-orange-300 w-ful p-1 text-center text-[1.2em] shadow-md shadow-orange-400/50 text-orange-800 text-shadow-xs" >
          <%= alert %>
        </div>
        <% end %>
      </div>

      <div class="relative mt-10 w-11/12 m-auto mb-20">
        <%= yield %>
      </div>
    <% else %>
      <div class="grid h-screen place-items-center w-full bg-gray-100 p-0 m-0">
        <%- if notice  %>
          <div class="notice bg-green-300 w-1/2 p-1 text-center text-[1.2em] shadow-md rounded-sm shadow-green-400/50 text-green-700 text-shadow-xs">
            <%= notice %>
          </div>
        <% end %>

        <%- if alert  %>
          <div class="alert notice bg-orange-300 w-1/2 p-1 text-center text-[1.2em] shadow-md rounded-sm shadow-orange-400/50 text-orange-800 text-shadow-xs" >
            <%= alert %>
          </div>
        <% end %>

        <%= yield %>

      </div>
    <% end %>
  </body>
</html>
