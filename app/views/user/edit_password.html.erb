<%= box_container do %>
  <% content_for :title, "Edit Password" %>
  <div class="bg-gray-300 rounded-t-md py-2 text-lg text-gray-500 shadow-sm/20">
    Edit Password
  </div>
  <div class="p-2 text-left">
    <%= form_with(model: @user, url: update_user_password_path, method: :put, builder: FormBuilders::Common) do |form| %>
      <%= form.password_field :current_password, autofocus: true %>
      <%= form.password_field :password %>
      <%= form.password_field :password_confirmation %>
      <%= form.divider %>
      <%= form.buttons do %>
        <%= form.submit "Save" %>
        <%= link_to_back %>
      <% end %>
    <% end %>
  </div>
<% end %>
